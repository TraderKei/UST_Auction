# PostgreSQL 16 connection. Do not place a real password in this file.
UST_DATABASE_URL=postgresql+psycopg://ust_app@localhost:5432/ust_data
UST_RAW_ROOT=./data/raw
UST_USER_AGENT=ust-auction-qra-pipeline/0.1 (operator-contact@example.invalid)
UST_HTTP_TIMEOUT_SECONDS=30
UST_HTTP_MAX_RETRIES=4
UST_HTTP_BACKOFF_BASE_SECONDS=0.5
# Optional PEM bundle override. Empty uses the Windows/system trust store.
UST_CA_BUNDLE=
UST_QRA_REQUEST_DELAY_SECONDS=1.0
UST_AUCTION_PAGE_SIZE=1000
UST_AUCTION_OVERLAP_DAYS=45
UST_INITIAL_FROM_DATE=1979-01-01
UST_INITIAL_TO_DATE=2099-12-31
UST_LOG_LEVEL=INFO
